# raghub — local-first development env.
#
# Copy to `.env` and fill in your real values. Real keys must NEVER
# be committed. The Settings loader (loadSettings in @raghub/core)
# reads every RAGHUB_* key below; unknown RAGHUB_* keys produce a
# warning, not an error.

# Auth — JWT (HS256) and tenant secret key (AES-256-GCM).
# Generate the JWT secret with: openssl rand -base64 48
# Generate the tenant secret key with: openssl rand -hex 32
RAGHUB_JWT_SECRET=
RAGHUB_TENANT_SECRETS_KEY=

# Embedder + LLM.
OPENAI_API_KEY=
RAGHUB_EMBEDDER_PROVIDER=openai
RAGHUB_EMBEDDER_MODEL=text-embedding-3-large
RAGHUB_LLM_PROVIDER=openai
RAGHUB_LLM_MODEL=gpt-4.1

# Vector store (sqlite-vec only).
RAGHUB_VECTOR_BACKEND=sqlite_vec
RAGHUB_VECTOR_PATH=./.raghub/raghub.db
RAGHUB_VECTOR_EMBEDDING_DIM=3072

# Orchestrator (mode / ordering / k / reranker).
RAGHUB_ORCHESTRATOR_MODE=graph
RAGHUB_ORCHESTRATOR_ORDERING=standard
RAGHUB_ORCHESTRATOR_TOP_K=10
RAGHUB_ORCHESTRATOR_RERANKER=identity

# Hybrid retrieval (RRF).
RAGHUB_HYBRID_DENSE_WEIGHT=0.6
RAGHUB_HYBRID_SPARSE_WEIGHT=0.4
RAGHUB_HYBRID_RRF_K=60
RAGHUB_HYBRID_COLBERT=false

# Telemetry (noop | langfuse | otel).
RAGHUB_TELEMETRY_PROVIDER=noop
RAGHUB_LANGFUSE_PUBLIC_KEY=
RAGHUB_LANGFUSE_SECRET_KEY=
RAGHUB_OTEL_ENDPOINT=

# Web → API base URL.
RAGHUB_API_BASE=http://localhost:3000