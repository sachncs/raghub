{
  "name": "@raghub/core",
  "version": "1.1.0",
  "description": "raghub core — domain types, stores, retrieval, ingest, auth, tenants, telemetry.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./__internal": {
      "types": "./dist/__internal.d.ts",
      "default": "./dist/__internal.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "echo \"(lint placeholder)\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "3.23.8",
    "openai": "4.71.1",
    "jose": "5.9.6",
    "bcryptjs": "2.4.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "12.11.1",
    "sqlite-vec": "0.1.9",
    "langfuse": "3.27.0",
    "@opentelemetry/api": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/better-sqlite3": "7.6.11",
    "@types/bcryptjs": "2.4.6",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}