{
  "name": "@raghub/cli",
  "version": "1.0.0",
  "description": "raghub CLI — init, migrate, ingest, dev.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "raghub": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "echo \"(lint placeholder)\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -raf dist .turbo"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@raghub/core": "workspace:*",
    "@raghub/orchestrator": "workspace:*",
    "@raghub/api": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}