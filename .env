# LLM credentials for `devtools/financebench.py`.
#
# `financebench.py` reads these three variables from the environment.
# Source this file before running the script, or export the variables
# inline:
#
#   source .env
#   python devtools/financebench.py
#
# or
#
#   RAG_LLM_BASE_URL=... RAG_LLM_API_KEY=... RAG_LLM_MODEL=... \
#       python devtools/financebench.py
#
# Or pass them inline to a one-shot run:
#
#   set -a; source .env; set +a; python devtools/financebench.py

# OpenAI-compatible endpoint.
RAG_LLM_BASE_URL=https://api.minimax.io/v1

# The model name as the OpenAI-compatible endpoint expects it.
RAG_LLM_MODEL=MiniMax-M3

# Your real key.
